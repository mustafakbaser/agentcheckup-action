{
  "name": "main: integrity",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": { "include": ["~DEFAULT_BRANCH"], "exclude": [] }
  },
  "bypass_actors": [],
  "rules": [
    { "type": "deletion" },
    { "type": "non_fast_forward" },
    { "type": "required_linear_history" },
    { "type": "required_signatures" },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          { "context": "Scripts", "integration_id": 15368 },
          { "context": "Action with a packed CLI", "integration_id": 15368 },
          { "context": "Action with the npm release", "integration_id": 15368 },
          { "context": "Invalid inputs", "integration_id": 15368 },
          { "context": "zizmor", "integration_id": 15368 }
        ]
      }
    }
  ]
}
